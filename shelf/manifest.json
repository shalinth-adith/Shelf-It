{
  "manifest_version": 3,
  "name": "Shelf It",
  "version": "1.0.0",
  "description": "Keep every passage worth keeping — on your own machine.",

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_title": "Shelf It",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "commands": {
    "open-shelf": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open the shelf"
    },
    "save-page": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Save the current page"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
